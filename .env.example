# Copy to .env and fill. .env is gitignored — never commit real values.
# See SETUP.md for where each comes from.

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Database (Neon Postgres + pgvector)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Model provider — pick one
MODEL_PROVIDER=anthropic          # anthropic | openrouter | ollama
MODEL_NAME=claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Local dev: Ollama for a no-cost offline model
OLLAMA_BASE_URL=http://localhost:11434
